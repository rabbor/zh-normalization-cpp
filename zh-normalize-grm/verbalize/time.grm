# 对应 tn/chinese/rules/time.py::Time.build_verbalizer()
# time { hours: "三点" minutes: "三十分" seconds: "零五秒" zone: "上午" }
# 经 TokenParser 重排后顺序：zone(noon) → hours → minutes → seconds

#import 'byte.grm' as b;
#import 'util.grm' as u;
